# Copy to malco_framework/.env.local. Offline demo needs no credentials.
MALCO_MODE=demo
# PYTHON_EXECUTABLE=D:/path/to/python.exe
# MALCO_ROOT=D:/path/to/repository
# MALCO_OUTPUT_DIR=D:/path/to/repository/output/demo
# MALCO_MODELS_DIR=D:/path/to/repository/output/demo/models
# MALCO_TASKS=2yrM,3yrM,4yrM,5yrM,Cancer,COPD,Pneumonia,rehos

# Live mode requires exact provider-supported model IDs; demo sends no requests.
# MALCO_MODE=live
# CHAT_BASE_URL=https://your-provider.example/v1
# CHAT_API_KEY=
# CHAT_MODEL=
# REVIEW_BASE_URL=https://your-provider.example/v1
# REVIEW_API_KEY=
# REVIEW_MODELS=[{"key":"reviewer1","model":"provider-model-id-1"},{"key":"reviewer2","model":"provider-model-id-2"},{"key":"reviewer3","model":"provider-model-id-3"}]
# Optional per-reviewer endpoint/key: add "envPrefix":"REVIEWER1" to a reviewer,
# then define REVIEWER1_BASE_URL and REVIEWER1_API_KEY.
# Historical trial configurations are separate from current demo settings.
